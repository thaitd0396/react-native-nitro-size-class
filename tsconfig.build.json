{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "jsx": "react-jsx",
    "module": "Node16",
    "moduleResolution": "Node16",
    "customConditions": [],
    "resolvePackageJsonImports": false,
    "resolvePackageJsonExports": false,
    "moduleSuffixes": [
      ".ios",
      ""
    ],
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "react",
      "react-native"
    ],
    "allowImportingTsExtensions": false
  },
  "exclude": [
    "src/**/__tests__/**"
  ]
}
